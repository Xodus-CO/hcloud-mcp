{
  "name": "hcloud-mcp",
  "version": "0.3.0",
  "description": "Standalone MCP server for Hetzner Cloud API — use with Cursor, Claude Desktop, CLI, or any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills",
    "run.js"
  ],
  "bin": {
    "hcloud-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test:api": "node scripts/test-list-api.mjs",
    "test:mcp": "node scripts/test-mcp-list.mjs",
    "test:live": "node scripts/test-live-lifecycle.mjs",
    "test:live:dns": "node scripts/test-live-dns.mjs",
    "test:live:images": "node scripts/test-live-images.mjs",
    "test:live:ops": "node scripts/test-live-server-ops.mjs",
    "test:live:actions": "node scripts/test-live-action-gaps.mjs",
    "test:live:certs": "node scripts/test-live-certificates.mjs",
    "test:live:storage": "node scripts/test-live-storage-box.mjs",
    "audit:api": "cross-env DRY_RUN=1 node scripts/audit-api-shapes.mjs"
  },
  "keywords": [
    "mcp",
    "hetzner",
    "hcloud",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xodus-CO/hcloud-mcp.git"
  },
  "homepage": "https://github.com/Xodus-CO/hcloud-mcp#readme",
  "bugs": "https://github.com/Xodus-CO/hcloud-mcp/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.3.1",
    "hetzner-sdk-ts": "^1.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "cross-env": "^7.0.3",
    "typescript": "^5.4.5"
  }
}
